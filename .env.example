# Copier vers .env (jamais commité). Changer TOUS les secrets en production.
POSTGRES_USER=mysuite
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mysuite
DATABASE_URL=postgres://mysuite:change-me-strong-password@db:5432/mysuite

# API
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,sqlx=warn
SESSION_TTL_HOURS=12
# true en production (HTTPS obligatoire). false uniquement en développement HTTP.
COOKIE_SECURE=false
RUN_MIGRATIONS=true
# Quatre yeux : le créateur d'un jeu de règles de paie ne peut pas l'approuver.
PAYROLL_FOUR_EYES=true
# Clé de chiffrement des secrets MFA (TOTP), 32 octets en hexadécimal : `openssl rand -hex 32`.
# Sans cette clé, le MFA est indisponible. La perdre rend les secrets MFA existants inutilisables
# (un administrateur doit alors réinitialiser le MFA des comptes concernés). Ne jamais la commiter.
MFA_ENCRYPTION_KEY=
# Envoi des liens de réinitialisation par courriel (facultatif ; vide = désactivé, lien à transmettre à la main).
SMTP_HOST=
SMTP_PORT=
# starttls (défaut, port 587) ou implicit (TLS implicite, port 465)
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Adresse publique de l'application, utilisée dans le lien (ex. https://rh.exemple.cd)
APP_BASE_URL=
# Origine CORS : laisser vide (frontend et API sur la même origine via le reverse proxy).
CORS_ORIGIN=

# Administrateur plateforme (commande `mysuite create-admin`)
MYSUITE_ADMIN_PASSWORD=change-me-Admin-2026
